# ─────────────────────────────────────────────────────────────
#  Market Genie — API Keys Configuration
#  Copy this file to .env and fill in your keys.
#  Get keys here:
#    Finnhub (free):     https://finnhub.io  →  Sign up → Dashboard
#    Quiver Quant:       https://www.quiverquant.com  →  Subscribe → API key
# ─────────────────────────────────────────────────────────────

# REQUIRED for real-time quotes, price charts, company profiles, news
FINNHUB_API_KEY=your_finnhub_key_here

# OPTIONAL — enables Congress trade tracking panel
# Free tier available at quiverquant.com
QUIVER_API_KEY=your_quiver_key_here

# ── Alpaca Paper Trading ─────────────────────────────────────────────────────
# REQUIRED to actually place trades. Without these the Alpha Engine still
# generates signals, but the executor will skip every order with
# "[Alpaca] Keys not configured — skipping order".
# Get keys at https://alpaca.markets → Paper Trading dashboard → API Keys
ALPACA_API_KEY=your_alpaca_key_here          # paper key (starts with PK...)
ALPACA_SECRET_KEY=your_alpaca_secret_here    # paper secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper endpoint (use https://api.alpaca.markets for LIVE)
ALPACA_EXEC_ENABLED=true                     # master switch — set to false to pause auto-execution

# ── Push Notifications (ntfy.sh) ─────────────────────────────────────────────
# Pick any unique topic name (like market-genie-yourname-1234).
# Subscribe to it in the free ntfy app (iOS/Android) or at https://ntfy.sh
# Set the same value in Railway Variables as NTFY_TOPIC.
NTFY_TOPIC=market-genie-yourname-1234

# Optional: self-host ntfy or use a custom server (default: https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh

# ── AI Trade Thesis (Claude) ─────────────────────────────────────────────────
# Get a free key at console.anthropic.com → API Keys
# Named CLAUDE_KEY (not ANTHROPIC_API_KEY) to avoid Railway build failures
CLAUDE_KEY=sk-ant-api03-your-key-here

# ── Alert Thresholds (optional — defaults shown) ──────────────────────────────
ALERT_GAP_PCT=2.5       # fire gap alert when pre-market gap >= this %
ALERT_KRONOS_SCORE=70   # fire Kronos alert when score >= this (0-100)
ALERT_VOLUME_MULT=3.0   # fire volume alert when volume >= N x 30-day avg
